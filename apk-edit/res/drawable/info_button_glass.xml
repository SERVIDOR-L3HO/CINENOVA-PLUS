<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#B52C7DB8"
                android:centerColor="#A52B5C8C"
                android:endColor="#B523385B" />
            <corners android:radius="22.0dip" />
            <stroke android:width="1.5dip" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#7AFFFFFF"
                android:centerColor="#593A9BC5"
                android:endColor="#7A16273D" />
            <corners android:radius="22.0dip" />
            <stroke android:width="1.0dip" android:color="#A8D9F7FF" />
        </shape>
    </item>
</selector>