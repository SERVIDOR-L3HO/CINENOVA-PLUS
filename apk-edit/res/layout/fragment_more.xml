<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:background="@drawable/more_background"
    android:fitsSystemWindows="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="16.0dip"
        android:paddingTop="10.0dip"
        android:paddingRight="16.0dip"
        android:paddingBottom="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@id/toolbar"
            android:background="@drawable/more_toolbar_glass"
            android:layout_width="fill_parent"
            android:layout_height="88.0dip"
            android:layout_marginBottom="18.0dip"
            app:popupTheme="@style/AppTheme.PopupOverlay">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="118.0dip"
                android:layout_height="54.0dip"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name"
                android:src="@drawable/cinenova_wordmark" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="14.0dip"
                android:paddingStart="14.0dip"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent">
                <TextView
                    android:textSize="24.0sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Más" />
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="#B9DFF2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu espacio CINENOVA" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <TextView
            android:textSize="13.0sp"
            android:textColor="#A7C7D9"
            android:paddingLeft="4.0dip"
            android:paddingRight="4.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip"
            android:text="Todo lo que necesitas, en un solo lugar" />

        <FrameLayout
            android:id="@id/fl_support"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?selectableItemBackground"
            android:background="@drawable/more_item_glass"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="66.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip"
                    android:background="@drawable/more_icon_circle"
                    android:padding="11.0dip"
                    app:srcCompat="@drawable/ic_baseline_send_24" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:layout_marginLeft="14.0dip"
                    android:layout_marginStart="14.0dip">
                    <TextView
                        android:textSize="18.0sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="Soporte" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#A7C7D9"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="Estamos para ayudarte" />
                </LinearLayout>
                <TextView
                    android:textSize="28.0sp"
                    android:textColor="#A9E7FF"
                    android:gravity="center"
                    android:layout_width="24.0dip"
                    android:layout_height="wrap_content"
                    android:text="›" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@id/fl_share"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?selectableItemBackground"
            android:background="@drawable/more_item_glass"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="66.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip"
                    android:background="@drawable/more_icon_circle"
                    android:padding="11.0dip"
                    app:srcCompat="@drawable/ic_baseline_share_24" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:layout_marginLeft="14.0dip"
                    android:layout_marginStart="14.0dip">
                    <TextView
                        android:textSize="18.0sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="Compartir" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#A7C7D9"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="Cuéntale a otros por qué es mejor" />
                </LinearLayout>
                <TextView
                    android:textSize="28.0sp"
                    android:textColor="#A9E7FF"
                    android:gravity="center"
                    android:layout_width="24.0dip"
                    android:layout_height="wrap_content"
                    android:text="›" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@id/fl_files"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?selectableItemBackground"
            android:background="@drawable/more_item_glass"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="66.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip"
                    android:background="@drawable/more_icon_circle"
                    android:padding="11.0dip"
                    android:src="@android:drawable/stat_sys_download_done"
                    android:tint="@android:color/white" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:layout_marginLeft="14.0dip"
                    android:layout_marginStart="14.0dip">
                    <TextView
                        android:textSize="18.0sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="Descargas" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#A7C7D9"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="Tus contenidos guardados" />
                </LinearLayout>
                <TextView
                    android:textSize="28.0sp"
                    android:textColor="#A9E7FF"
                    android:gravity="center"
                    android:layout_width="24.0dip"
                    android:layout_height="wrap_content"
                    android:text="›" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@id/fl_settings"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?selectableItemBackground"
            android:background="@drawable/more_item_glass"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="66.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip"
                    android:background="@drawable/more_icon_circle"
                    android:padding="11.0dip"
                    app:srcCompat="@drawable/ic_baseline_settings_24" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:layout_marginLeft="14.0dip"
                    android:layout_marginStart="14.0dip">
                    <TextView
                        android:textSize="18.0sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="Configuración" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#A7C7D9"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="Personaliza tu experiencia" />
                </LinearLayout>
                <TextView
                    android:textSize="28.0sp"
                    android:textColor="#A9E7FF"
                    android:gravity="center"
                    android:layout_width="24.0dip"
                    android:layout_height="wrap_content"
                    android:text="›" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>